<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rentcar.controller.ReconciliationController" spacing="12" style="-fx-padding: 4;">
    <Label text="Payment reconciliation" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Review reservations whose payment result is uncertain. Releasing a reservation frees its vehicle dates, but does not prove that no charge occurred." wrapText="true" style="-fx-text-fill: #92400e;"/>
    <TableView fx:id="reviewTable" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="idColumn" text="Reservation" prefWidth="105"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="110"/>
            <TableColumn fx:id="vehicleColumn" text="Vehicle" prefWidth="95"/>
            <TableColumn fx:id="startColumn" text="Start" prefWidth="105"/>
            <TableColumn fx:id="endColumn" text="End" prefWidth="105"/>
            <TableColumn fx:id="totalColumn" text="Total (COP)" prefWidth="110"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
        </columns>
    </TableView>
    <Label text="Reconciliation reason (required)" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="reasonArea" promptText="Example: Checked simulator transaction logs; payment was not captured." prefRowCount="2" wrapText="true"/>
    <HBox spacing="10">
        <Button text="Refresh" onAction="#refresh"/>
        <Button fx:id="releaseButton" text="Release selected reservation" onAction="#releaseSelected" disable="true" style="-fx-background-color: #b45309; -fx-text-fill: white;"/>
    </HBox>
    <Label fx:id="messageLabel" wrapText="true"/>
</VBox>
